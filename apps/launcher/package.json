{
  "name": "launcher",
  "version": "0.0.3",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "icon": "node scripts/generate-icon.js",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.drift.launcher",
    "productName": "Drift Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "lo-protos",
        "to": "lo-protos"
      }
    ],
    "extraFiles": [
      "steam_api64.dll",
      "steam_appid.txt"
    ],
    "asarUnpack": [
      "**/node_modules/steamworks.js/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "artifactName": "DriftLauncher-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Drift Launcher",
      "artifactName": "DriftLauncher-${version}-${os}-${arch}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "axios": "^1.7.0",
    "electron-store": "^8.2.0",
    "protobufjs": "^7.4.0",
    "steamworks.js": "^0.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
